DATABASE_URL=postgresql://devuser:devpassword@localhost:5432/devdb
PORT=8000
NODE_ENV=development
JWT_SECRET=replace-with-strong-secret
ENCRYPTION_KEY=replace-with-64-hex-chars

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_PREFETCH=10
WORKER_CONCURRENCY=4

# Cloudinary (artifact uploads)
# Option A (recommended): single URL
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
#
# Option B: discrete vars
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Isolated build Docker images (language-level; override any with BUILD_IMAGE_<LANG>)
# BUILD_IMAGE_JAVASCRIPT=node:22-bookworm
# BUILD_IMAGE_PHP=composer:2
# BUILD_IMAGE_PYTHON=python:3.12-bookworm
# BUILD_IMAGE_GO=golang:1.23-bookworm
# BUILD_IMAGE_RUST=rust:1-bookworm
# BUILD_IMAGE_RUBY=ruby:3.3-bookworm
# BUILD_IMAGE_GENERIC=ubuntu:22.04
